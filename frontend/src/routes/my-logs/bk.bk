import {
  createFileRoute,
  redirect,
  useNavigate,
  useParams,
} from "@tanstack/react-router";
import { useState, useEffect } from "react";
import { useMutation } from "@tanstack/react-query";
import axios from "axios";

import useFindWorkout from "../../api/workouts/use-find-workout";
import { enable } from "colors";

type ExerciseSet = {
  reps: number;
  weight: number;
};

type ExerciseLog = {
  exercise: string; // Exercise ID
  sets: ExerciseSet[];
  duration?: number;
  distance?: number;
  notes?: string;
};

export const Route = createFileRoute("/logs/$new")({
  beforeLoad: async ({ location }) => {
    const user = localStorage.getItem("user");

    if (!user) {
      throw redirect({
        to: "/auth",
        search: {
          redirect: location.href,
        },
      });
    }
  },
  component: CreateLog,
});

function CreateLog() {
  const { id } = useParams({ strict: false });
  const navigate = useNavigate();
  const { data: workout, isLoading } = useFindWorkout(id as string, {
    enabled: !!id,
  });
  console.log("workout", workout);
  const [date, setDate] = useState(new Date().toISOString().split("T")[0]);
  const [exercises, setExercises] = useState<ExerciseLog[]>([]);
  const [totalDuration, setTotalDuration] = useState(0);
  const [notes, setNotes] = useState("");
  const [rating, setRating] = useState(5);
  const [feelingScore, setFeelingScore] = useState(7);

  const logWorkoutMutation = useMutation({
    mutationFn: async () => {
      const response = await axios.post("/api/logs", {
        id,
        date,
        exercises,
        totalDuration,
        notes,
        rating,
        feelingScore,
      });
      return response.data;
    },
    onSuccess: () => {
      navigate({ to: "/logs" });
    },
  });

  // Handle adding a set to an exercise
  const handleAddSet = (exerciseIndex: number) => {
    setExercises((prevExercises) => {
      const updatedExercises = [...prevExercises];
      updatedExercises[exerciseIndex].sets.push({ reps: 0, weight: 0 });
      return updatedExercises;
    });
  };

  // Handle updating set data
  const handleSetChange = (
    exerciseIndex: number,
    setIndex: number,
    field: keyof ExerciseSet,
    value: number
  ) => {
    setExercises((prevExercises) => {
      const updatedExercises = [...prevExercises];
      updatedExercises[exerciseIndex].sets[setIndex][field] = value;
      return updatedExercises;
    });
  };

  // Handle updating cardio data
  const handleCardioChange = (
    exerciseIndex: number,
    field: "duration" | "distance",
    value: number
  ) => {
    setExercises((prevExercises) => {
      const updatedExercises = [...prevExercises];
      updatedExercises[exerciseIndex][field] = value;
      return updatedExercises;
    });
  };

  // Handle exercise notes
  const handleExerciseNotes = (exerciseIndex: number, value: string) => {
    setExercises((prevExercises) => {
      const updatedExercises = [...prevExercises];
      updatedExercises[exerciseIndex].notes = value;
      return updatedExercises;
    });
  };

  // Determine if an exercise is cardio-based
  const isCardioExercise = (exerciseId: string) => {
    const exercise = workout?.exercises.find(
      (ex) => ex && ex._id === exerciseId
    );
    return exercise?.category.includes("cardio");
  };

  if (isLoading) {
    return <div>Loading workout details...</div>;
  }

  if (!workout) {
    return <div>Workout not found</div>;
  }
  return (
    <div className="p-4">
      <h2 className="text-xl font-bold mb-4">Log: {workout?.name}</h2>

      <div className="mb-4">
        <label className="block mb-1">Date</label>
        <input
          type="date"
          value={date}
          onChange={(e) => setDate(e.target.value)}
          className="w-full p-2 border rounded"
        />
      </div>

      {exercises.map((exerciseLog, exerciseIndex) => {
        const exercise = workout?.exercises.find(
          (ex) => ex && ex._id === exerciseLog.exercise
        );
        const isCardio = exercise && isCardioExercise(exercise._id);

        return (
          <div key={exerciseIndex} className="mb-6 p-4 border rounded">
            <h3 className="font-bold mb-2">
              {exercise ? exercise.name : "Exercise"}
            </h3>

            {isCardio ? (
              // Cardio exercise logging
              <div className="grid grid-cols-2 gap-4 mb-2">
                <div>
                  <label className="block text-sm">Duration (minutes)</label>
                  <input
                    type="number"
                    value={exerciseLog.duration || 0}
                    onChange={(e) =>
                      handleCardioChange(
                        exerciseIndex,
                        "duration",
                        parseInt(e.target.value)
                      )
                    }
                    className="w-full p-2 border rounded"
                    min="0"
                  />
                </div>
                <div>
                  <label className="block text-sm">Distance (km/miles)</label>
                  <input
                    type="number"
                    value={exerciseLog.distance || 0}
                    onChange={(e) =>
                      handleCardioChange(
                        exerciseIndex,
                        "distance",
                        parseFloat(e.target.value)
                      )
                    }
                    className="w-full p-2 border rounded"
                    min="0"
                    step="0.01"
                  />
                </div>
              </div>
            ) : (
              // Strength exercise logging
              <div>
                <table className="w-full mb-2">
                  <thead>
                    <tr>
                      <th className="text-left">Set</th>
                      <th className="text-left">Reps</th>
                      <th className="text-left">Weight</th>
                    </tr>
                  </thead>
                  <tbody>
                    {exerciseLog.sets.map((set, setIndex) => (
                      <tr key={setIndex}>
                        <td>{setIndex + 1}</td>
                        <td>
                          <input
                            type="number"
                            value={set.reps}
                            onChange={(e) =>
                              handleSetChange(
                                exerciseIndex,
                                setIndex,
                                "reps",
                                parseInt(e.target.value)
                              )
                            }
                            className="w-full p-2 border rounded"
                            min="0"
                          />
                        </td>
                        <td>
                          <input
                            type="number"
                            value={set.weight}
                            onChange={(e) =>
                              handleSetChange(
                                exerciseIndex,
                                setIndex,
                                "weight",
                                parseFloat(e.target.value)
                              )
                            }
                            className="w-full p-2 border rounded"
                            min="0"
                            step="0.5"
                          />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                <button
                  onClick={() => handleAddSet(exerciseIndex)}
                  className="text-sm bg-gray-200 px-3 py-1 rounded"
                >
                  Add Set
                </button>
              </div>
            )}

            <div className="mt-2">
              <label className="block text-sm">Notes for this exercise</label>
              <input
                type="text"
                value={exerciseLog.notes || ""}
                onChange={(e) =>
                  handleExerciseNotes(exerciseIndex, e.target.value)
                }
                className="w-full p-2 border rounded"
                placeholder="Optional notes"
              />
            </div>
          </div>
        );
      })}

      <div className="mb-4">
        <label className="block mb-1">Total Workout Duration (minutes)</label>
        <input
          type="number"
          value={totalDuration}
          onChange={(e) => setTotalDuration(parseInt(e.target.value))}
          className="w-full p-2 border rounded"
          min="0"
        />
      </div>

      <div className="mb-4">
        <label className="block mb-1">Overall Notes</label>
        <textarea
          value={notes}
          onChange={(e) => setNotes(e.target.value)}
          className="w-full p-2 border rounded"
          rows={3}
          placeholder="How was your workout?"
        />
      </div>

      <div className="grid grid-cols-2 gap-4 mb-6">
        <div>
          <label className="block mb-1">Workout Rating (1-5)</label>
          <select
            value={rating}
            onChange={(e) => setRating(parseInt(e.target.value))}
            className="w-full p-2 border rounded"
          >
            {[1, 2, 3, 4, 5].map((num) => (
              <option key={num} value={num}>
                {num} - {num === 1 ? "Poor" : num === 5 ? "Excellent" : ""}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label className="block mb-1">How did you feel? (1-10)</label>
          <select
            value={feelingScore}
            onChange={(e) => setFeelingScore(parseInt(e.target.value))}
            className="w-full p-2 border rounded"
          >
            {Array.from({ length: 10 }, (_, i) => i + 1).map((num) => (
              <option key={num} value={num}>
                {num} - {num <= 3 ? "Tired" : num >= 8 ? "Energized" : "Normal"}
              </option>
            ))}
          </select>
        </div>
      </div>

      <button
        onClick={() => logWorkoutMutation.mutate()}
        disabled={logWorkoutMutation.isPending}
        className="bg-blue-500 text-white px-4 py-2 rounded disabled:bg-gray-300"
      >
        {logWorkoutMutation.isPending ? "Saving..." : "Log Workout"}
      </button>
    </div>
  );
}
